{{!
    Student play view for mod_agon (frontend skeleton).
    Content is filled in by js/student.js from window.AGON (mock data for now).
}}
<div class="agon">
  <div class="app show-explain-off" id="agon-app">
    <header class="app__header">
      <div>
        <div class="app__title">Agon</div>
        <div class="app__sub" id="a-sub">{{subject}}</div>
      </div>
      <div class="head-side">
        <span class="pill" id="a-week">Week {{week}}</span>
        <label class="switch" title="Show explanations"><input type="checkbox" id="explain-toggle"><span class="track"></span><span>Explain</span></label>
        <button class="hint-btn" id="hint" title="Hint (one per attempt)" type="button">&#128161;</button>
      </div>
    </header>

    <main class="app__content" id="app-content">
      <section class="stage is-active" id="stage-start">
        <div class="ag-card">
          <div class="kicker">Today's challenge</div>
          <h2 class="stage__title">{{subject}}</h2>
          <p class="lead">Three mini-games: crossword, weekly question, and coding. Earn points for the course leaderboard.</p>
          <div class="ag-card" style="margin:0;background:#eef7f1;border-color:#cfe9da">
            <b>Scoring</b><br>
            Crossword: 1st&ndash;3rd = <b>1.0</b>, 4th&ndash;10th = <b>0.75</b>, others = <b>0.5</b><br>
            Question: correct = <b>1.0</b> &middot; Coding: 2 &times; <b>0.5</b> (partial)<br>
            1 hint &middot; 1 attempt
          </div>
        </div>
      </section>

      <section class="stage" id="stage-crossword">
        <div class="kicker">Game 1 &middot; Recall</div>
        <h2 class="stage__title">Crossword</h2>
        <p class="lead">Fill in the words from the clues. No time limit.</p>
        <div class="ag-card"><div class="cw" id="cw"></div></div>
        <div class="ag-card clues" id="clues"></div>
      </section>

      <section class="stage" id="stage-question">
        <div class="kicker">Game 2 &middot; Understand</div>
        <h2 class="stage__title">Weekly question</h2>
        <div class="timer">&#9201; 0:30</div>
        <div class="ag-card" id="q-host"></div>
      </section>

<section class="stage" id="stage-coding">
        <div class="kicker">Game 3 &middot; Apply</div>
        <h2 class="stage__title">Coding</h2>
        <div class="timer">&#9201; 1:30</div>
        <p class="lead">Reveal each line with &#9660;, then drag an option into a blank (or click an option then a blank). Click a filled blank to clear it. Two sequences, 0.5 each.</p>
        <div id="coding"></div>
      </section>

      <section class="stage" id="stage-review">
        <h2 class="stage__title">Correct sequence</h2>
        <div class="explain-row">
          <div class="ag-card">
            <div class="code" id="review-code"></div>
          </div>
          <div class="ag-card explain"><div class="kicker">Explanation</div><div id="review-explain"></div></div>
        </div>
      </section>

      <section class="stage" id="stage-results">
        <h2 class="stage__title">Today's score</h2>
        <div class="ag-card">
          <div class="score-big">2.25</div>
          <div class="score-row"><span>Crossword</span><b>1.00</b></div>
          <div class="score-row"><span>Question</span><b>1.00</b></div>
          <div class="score-row"><span>Coding</span><b>0.25</b></div>
        </div>
        <div class="ag-card">
          <div class="kicker">Course leaderboard</div>
          <ul class="lb" id="lb"></ul>
        </div>
      </section>
    </main>

    <footer class="app__footer">
      <nav class="stepper" id="stepper"></nav>
      <button class="ag-btn ag-btn--primary" id="cta" type="button">Start</button>
    </footer>
  </div>
</div>
